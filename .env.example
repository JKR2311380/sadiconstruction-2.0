# Copy to `.env` (gitignored). Vite only exposes keys prefixed with VITE_.

# Supabase project URL
VITE_SUPABASE_URL=

# Publishable key (Settings → API Keys). Safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy alias; the client still reads this if the publishable key is unset.
# VITE_SUPABASE_ANON_KEY=
